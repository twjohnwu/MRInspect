+// TestNewBatchCollection_MajorityWriteConcern guards against the
+// lost-write-on-failover bug: the collection must be opened with
+// writeconcern.Majority() instead of the client's default w:1.
+func TestNewBatchCollection_MajorityWriteConcern(t *testing.T) {
+	coll := NewBatchCollection(testDB)
+	wc := coll.WriteConcern()
+	if wc == nil || !wc.IsAcknowledged() {
+		t.Fatal("want an acknowledged write concern on pipeline_batches")
+	}
