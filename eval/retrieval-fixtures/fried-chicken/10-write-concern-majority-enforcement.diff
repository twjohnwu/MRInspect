Author: fryer-bot <fryer-bot@fried-chicken.internal>
Date:   Fri Oct 2 15:52:07 2026 +0800

    fix(batchstore): require majority write concern on the pipeline_batches collection

    NewBatchCollection opened the pipeline_batches collection using the
    client's default write concern, which on this cluster is w:1, so a
    write could be acknowledged and then lost on a primary failover
    before it replicated. NewBatchCollection now opens the collection
    with an explicit writeconcern.Majority() option, so an acknowledged
    write survives a failover.

diff --git a/internal/batchstore/collection.go b/internal/batchstore/collection.go
index 5c9e0a1..2b7d4f3 100644
--- a/internal/batchstore/collection.go
+++ b/internal/batchstore/collection.go
@@ -8,14 +8,19 @@ import (
 	"go.mongodb.org/mongo-driver/mongo/writeconcern"
 )

 func NewBatchCollection(db *mongo.Database) *mongo.Collection {
-	return db.Collection("pipeline_batches")
+	wc := writeconcern.Majority()
+	opts := options.Collection().SetWriteConcern(wc)
+	return db.Collection("pipeline_batches", opts)
 }
