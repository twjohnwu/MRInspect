 }
+
+// TestValidateCoatingSchedule_RejectsMissingSecondSample guards against the
+// undercounted-thickness bug: a DipCount of two with only one thickness
+// sample must return an error instead of being accepted.
+func TestValidateCoatingSchedule_RejectsMissingSecondSample(t *testing.T) {
+	s := Schedule{DipCount: 2, ThicknessSamplesMm: []float64{1.4}}
+	if err := ValidateCoatingSchedule(s); err == nil {
+		t.Fatal("want error for missing second thickness sample, got nil")
+	}
+}
