# mrinspect-fixture: source=e28b4c7 kind=logic

commit e28b4c75d1f3a90c6e2b5d8f014a7c3e6f0912b5
Author: fryer-bot <fryer-bot@fried-chicken.internal>
Date:   Wed Sep 30 08:47:52 2026 +0800

    fix(brinelistener): stop the consume loop cleanly on context.Canceled instead of panicking

    ConsumeLoop treated every error returned by the Kafka client the
    same way, including context.Canceled during a normal shutdown, and
    called log.Panic on it, so a routine deploy restart of brine-service
    crashed the process with a panic stack trace instead of exiting
    quietly. ConsumeLoop now checks errors.Is(err, context.Canceled)
    first and returns nil, reserving log.Panic for genuine client errors.

diff --git a/internal/brinelistener/listener.go b/internal/brinelistener/listener.go
index 4b8d0f2..a1e6c93 100644
--- a/internal/brinelistener/listener.go
+++ b/internal/brinelistener/listener.go
@@ -8,14 +8,20 @@ import (
 	"log"
 )

 func ConsumeLoop(ctx context.Context, client KafkaClient) error {
 	for {
 		msg, err := client.Fetch(ctx)
 		if err != nil {
-			log.Panicf("brinelistener: fetch failed: %v", err)
+			if errors.Is(err, context.Canceled) {
+				return nil
+			}
+			log.Panicf("brinelistener: fetch failed: %v", err)
 		}
 		process(msg)
 	}
 }
