+// TestUpsertBatch_SetsUpdatedAt guards against the stale-timestamp bug:
+// every upsert must write an updatedAt field, even when the caller's
+// fields map does not already include one.
+func TestUpsertBatch_SetsUpdatedAt(t *testing.T) {
+	fields := bson.M{"oilAgeHours": 4.2}
+	if err := UpsertBatch(context.Background(), testColl, "batch-9", fields); err != nil {
+		t.Fatalf("UpsertBatch: %v", err)
+	}
+	if _, ok := fields["updatedAt"]; !ok {
+		t.Fatal("want updatedAt set on upsert fields, got none")
+	}
