Author: fryer-bot <fryer-bot@fried-chicken.internal>
Date:   Thu Oct 1 13:05:39 2026 +0800

    fix(batchstore): set updatedAt on every pipeline_batches upsert

    UpsertBatch wrote the batch document to the pipeline_batches
    collection without touching an updatedAt field, so an upserted
    record kept whichever timestamp (or none) it happened to already
    carry and downstream staleness alerts could not tell a fresh write
    from a five-day-old one. UpsertBatch now sets updatedAt to the
    current time on the $set clause of every upsert.

diff --git a/internal/batchstore/store.go b/internal/batchstore/store.go
index 0a2c4e6..8b1d3f7 100644
--- a/internal/batchstore/store.go
+++ b/internal/batchstore/store.go
@@ -10,16 +10,22 @@ import (
 	"time"
 )

 func UpsertBatch(ctx context.Context, coll *mongo.Collection, id string, fields bson.M) error {
+	fields["updatedAt"] = time.Now().UTC()
 	filter := bson.M{"_id": id}
 	update := bson.M{"$set": fields}
 	opts := options.Update().SetUpsert(true)
 	_, err := coll.UpdateOne(ctx, filter, update, opts)
 	return err
 }
