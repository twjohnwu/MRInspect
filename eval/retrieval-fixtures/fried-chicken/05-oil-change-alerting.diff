+// TestHandleOilAgeEvent_CommitsAfterWrite guards against the message-loss
+// bug: the Kafka offset must not be committed until the MongoDB write for
+// the same message has succeeded.
+func TestHandleOilAgeEvent_CommitsAfterWrite(t *testing.T) {
+	var writeCalled, commitCalled bool
+	c := newTestConsumer(t,
+		withWriteHook(func() { writeCalled = true }),
+		withCommitHook(func() {
+			commitCalled = true
+			if !writeCalled {
+				t.Fatal("Commit called before WriteOilAgeState")
+			}
+		}),
+	)
+	if err := c.handleOilAgeEvent(context.Background(), fakeMessage()); err != nil {
+		t.Fatalf("handleOilAgeEvent: %v", err)
+	}
+	if !commitCalled {
+		t.Fatal("want Commit to be called after a successful write")
+	}
+}
