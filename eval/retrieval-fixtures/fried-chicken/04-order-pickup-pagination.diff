+// TestListPickupOrders_TieBreaksByOrderID guards against the pagination bug:
+// two orders sharing the same PickupETA must still resolve deterministically
+// through OrderID instead of both being skipped or both repeated.
+func TestListPickupOrders_TieBreaksByOrderID(t *testing.T) {
+	orders := []Order{
+		{PickupETA: 100, OrderID: "a"},
+		{PickupETA: 100, OrderID: "b"},
+		{PickupETA: 100, OrderID: "c"},
+	}
+	page := ListPickupOrders(orders, Cursor{PickupETA: 100, OrderID: "a"}, 10)
+	if len(page) != 2 || page[0].OrderID != "b" || page[1].OrderID != "c" {
+		t.Fatalf("page = %+v, want [b c] after cursor a", page)
+	}
+}
