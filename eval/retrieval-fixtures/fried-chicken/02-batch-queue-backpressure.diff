--- a/internal/batchqueue/queue_test.go
+++ b/internal/batchqueue/queue_test.go
@@ -20,3 +20,23 @@ func TestQueue_PendingCount(t *testing.T) {
 	}
 }
+
+// TestQueue_RejectsBeyondCapacity guards against the unbounded-growth bug:
+// Enqueue must return ErrQueueFull once maxPendingBatches is reached instead
+// of appending indefinitely.
+func TestQueue_RejectsBeyondCapacity(t *testing.T) {
+	q := &Queue{}
+	for i := 0; i < maxPendingBatches; i++ {
+		if err := q.Enqueue(Batch{ID: fmt.Sprintf("b-%d", i)}); err != nil {
+			t.Fatalf("Enqueue %d: unexpected error %v", i, err)
+		}
+	}
+	if err := q.Enqueue(Batch{ID: "overflow"}); !errors.Is(err, ErrQueueFull) {
+		t.Fatalf("Enqueue at capacity: got %v, want ErrQueueFull", err)
+	}
+	if q.PendingCount() != maxPendingBatches {
+		t.Fatalf("PendingCount = %d, want %d", q.PendingCount(), maxPendingBatches)
+	}
+}
