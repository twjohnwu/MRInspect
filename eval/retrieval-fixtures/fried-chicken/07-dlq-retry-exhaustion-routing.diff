@@ -14,3 +14,26 @@ func TestHandleBatchComplete_RetriesOnFailure(t *testing.T) {
 		t.Fatal("want error on first failure, got nil")
 	}
 }
+
+// TestHandleBatchComplete_RoutesToDLQAfterMaxRetries guards against the
+// infinite-retry bug: a message must be published to its DLQ topic once
+// RetryCount reaches maxConsumerRetries instead of retrying forever.
+func TestHandleBatchComplete_RoutesToDLQAfterMaxRetries(t *testing.T) {
+	var publishedTopic string
+	publish := func(ctx context.Context, topic string, m Message) error {
+		publishedTopic = topic
+		return nil
+	}
+	msg := Message{Topic: "chicken-pipeline", RetryCount: maxConsumerRetries - 1}
+	if err := handleBatchComplete(context.Background(), msg, publish); err != nil {
+		t.Fatalf("want DLQ publish to succeed, got %v", err)
+	}
+	if publishedTopic != "chicken-pipeline.dlq" {
+		t.Fatalf("published topic = %q, want %q", publishedTopic, "chicken-pipeline.dlq")
+	}
+}
