# mrinspect-fixture: source=d19f6b3 kind=logic

commit d19f6b3a5c8e2f70b1d4a6c9e3f0812d5b7a6e84
Author: fryer-bot <fryer-bot@fried-chicken.internal>
Date:   Tue Sep 29 11:38:21 2026 +0800

    fix(consumerretry): route a message to the DLQ topic after its third failed retry

    handleBatchComplete retried a failed frying-controller message
    forever on the original chicken-pipeline topic, so one permanently
    malformed batch.complete event could block the whole consumer group
    and stall every batch behind it. handleBatchComplete now tracks the
    per-message retry count and publishes to the {topic}.dlq topic once
    RetryCount reaches maxConsumerRetries, instead of retrying without
    limit.

diff --git a/internal/consumerretry/retry.go b/internal/consumerretry/retry.go
index 9c3e1a2..4f8b0d6 100644
--- a/internal/consumerretry/retry.go
+++ b/internal/consumerretry/retry.go
@@ -9,18 +9,25 @@ import (
 	"fmt"
 )

+const maxConsumerRetries = 3
+
 func handleBatchComplete(ctx context.Context, msg Message, publish PublishFunc) error {
 	if err := process(msg); err != nil {
-		return fmt.Errorf("consumerretry: process failed: %w", err)
+		msg.RetryCount++
+		if msg.RetryCount >= maxConsumerRetries {
+			return publish(ctx, msg.Topic+".dlq", msg)
+		}
+		return fmt.Errorf("consumerretry: process failed: %w", err)
 	}
 	return nil
 }
