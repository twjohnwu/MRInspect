@@ -30,3 +30,24 @@ func TestValidateFrySchedule_PositiveDuration(t *testing.T) {
 		t.Fatal("want error for non-positive duration, got nil")
 	}
 }
+
+// TestValidateFrySchedule_RejectsOutOfRangeTemp guards against the clamping
+// bug: a stage temperature outside the safety band without AckOverride must
+// return an error instead of being silently clamped into range.
+func TestValidateFrySchedule_RejectsOutOfRangeTemp(t *testing.T) {
+	stages := []Stage{{TargetTempC: 1600, DurationSec: 240}}
+	if err := ValidateFrySchedule(stages); err == nil {
+		t.Fatal("want error for out-of-range temp, got nil")
+	}
+	if stages[0].TargetTempC != 1600 {
+		t.Fatalf("want temp left unchanged at 1600, got %.1f", stages[0].TargetTempC)
+	}
+}
+
+// TestValidateFrySchedule_AcceptsAckedOverride verifies the documented
+// escape hatch: an out-of-range temp with AckOverride set passes validation.
+func TestValidateFrySchedule_AcceptsAckedOverride(t *testing.T) {
+	stages := []Stage{{TargetTempC: 140, DurationSec: 60, AckOverride: true}}
+	if err := ValidateFrySchedule(stages); err != nil {
+		t.Fatalf("want acked override to pass validation, got %v", err)
+	}
+}
