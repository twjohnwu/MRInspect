+
+// TestValidateBakeWindow_RejectsImplicitWrap guards against the negative-
+// duration bug: an overnight window with a bare end < start and no
+// OvernightSplit must be rejected instead of silently treated as a wrap.
+func TestValidateBakeWindow_RejectsImplicitWrap(t *testing.T) {
+	w := BakeWindow{
+		OvenID: "oven-3",
+		Start:  mustTime(t, "22:00"),
+		End:    mustTime(t, "06:00"),
+	}
+	if err := ValidateBakeWindow(w); err == nil {
+		t.Fatal("want error for implicit overnight wrap, got nil")
+	}
+}
+
+// TestValidateBakeWindow_AcceptsExplicitSplit verifies the documented
+// escape hatch: a window declared as two explicit non-wrapping intervals
+// in OvernightSplit passes validation.
+func TestValidateBakeWindow_AcceptsExplicitSplit(t *testing.T) {
+	w := BakeWindow{
+		OvenID: "oven-3",
+		Start:  mustTime(t, "22:00"),
+		End:    mustTime(t, "06:00"),
+		OvernightSplit: []Interval{
+			{Start: mustTime(t, "22:00"), End: mustTime(t, "23:59")},
+			{Start: mustTime(t, "00:00"), End: mustTime(t, "06:00")},
+		},
+	}
+	if err := ValidateBakeWindow(w); err != nil {
+		t.Fatalf("want explicit split to pass validation, got %v", err)
+	}
+}
