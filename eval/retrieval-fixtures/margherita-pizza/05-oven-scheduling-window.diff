# mrinspect-fixture: source=c14f2a9 kind=config

commit c14f2a91b6f0e8e3d2a479e0f4c9d31b8a7e5061
Author: kitchen-bot <kitchen-bot@margherita-pizza.internal>
Date:   Tue Sep 08 09:14:02 2026 +0800

    fix(ovenschedule): reject overnight bake window unless split into two explicit intervals

    ValidateBakeWindow silently treated `end < start` as an implicit
    overnight wrap, which produced a negative duration for any oven whose
    window happened to cross midnight. Bake duration and preheat lead time
    depend on that duration, so a wrapped window quietly scheduled ovens
    for zero or negative minutes. Overnight windows must now be declared
    as two explicit intervals in `OvernightSplit`; a single interval with
    `end < start` is a validation error instead of an implicit wrap.

diff --git a/internal/ovenschedule/schedule.go b/internal/ovenschedule/schedule.go
index 3f8a1c2..9d0e774 100644
--- a/internal/ovenschedule/schedule.go
+++ b/internal/ovenschedule/schedule.go
@@ -12,6 +12,7 @@ type BakeWindow struct {
 	OvenID         string
 	Start          time.Time
 	End            time.Time
+	OvernightSplit []Interval
 }

 type Interval struct {
@@ -20,14 +21,26 @@ type Interval struct {
 }

 func ValidateBakeWindow(w BakeWindow) error {
-	if w.End.Before(w.Start) {
-		// wraps past midnight; duration is computed against the next day
-		return nil
+	if w.End.Before(w.Start) {
+		if len(w.OvernightSplit) != 2 {
+			return fmt.Errorf("ovenschedule: window for %q crosses midnight but is not declared as two explicit intervals in OvernightSplit", w.OvenID)
+		}
+		for _, part := range w.OvernightSplit {
+			if part.End.Before(part.Start) {
+				return fmt.Errorf("ovenschedule: OvernightSplit interval for %q must not itself wrap", w.OvenID)
+			}
+		}
+		return nil
 	}
 	if w.Start.Equal(w.End) {
 		return fmt.Errorf("ovenschedule: window for %q has zero duration", w.OvenID)
 	}
 	return nil
 }
