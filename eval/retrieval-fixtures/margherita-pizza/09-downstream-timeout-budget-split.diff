+
+// TestSplitDownstreamDeadlines_BoundedShares verifies the fix: each
+// downstream call receives a bounded share of the remaining deadline, not
+// the full remaining deadline carried over from the previous call.
+func TestSplitDownstreamDeadlines_BoundedShares(t *testing.T) {
+	parent, cancel := context.WithTimeout(context.Background(), 300*time.Millisecond)
+	defer cancel()
+
+	kitchenCtx, paymentCtx, deliveryCtx, cleanup := splitDownstreamDeadlines(parent)
+	defer cleanup()
+
+	for name, ctx := range map[string]context.Context{
+		"kitchen": kitchenCtx, "payment": paymentCtx, "delivery": deliveryCtx,
+	} {
+		deadline, ok := ctx.Deadline()
+		if !ok {
+			t.Fatalf("%s: want a bounded deadline, got none", name)
+		}
+		if remaining := time.Until(deadline); remaining >= 300*time.Millisecond {
+			t.Fatalf("%s: want a bounded share, got the full remaining deadline (%v)", name, remaining)
+		}
+	}
+}
