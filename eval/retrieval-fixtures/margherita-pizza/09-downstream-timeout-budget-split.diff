@@ -12,20 +12,34 @@ import (
 )

-func dispatchDownstream(ctx context.Context, order Order) error {
-	if err := callKitchenAvailability(ctx, order); err != nil {
+const encodingBuffer = 50 * time.Millisecond
+
+// splitDownstreamDeadlines divides the remaining request deadline into
+// three bounded shares (kitchen, payment, delivery-quote) after reserving
+// encodingBuffer for response encoding and cleanup, so the first call
+// returning late in its own window cannot starve the calls after it.
+func splitDownstreamDeadlines(ctx context.Context) (kitchenCtx, paymentCtx, deliveryCtx context.Context, cancel func()) {
+	deadline, ok := ctx.Deadline()
+	if !ok {
+		return ctx, ctx, ctx, func() {}
+	}
+	remaining := time.Until(deadline) - encodingBuffer
+	share := remaining / 3
+	kitchenCtx, c1 := context.WithTimeout(ctx, share)
+	paymentCtx, c2 := context.WithTimeout(ctx, share)
+	deliveryCtx, c3 := context.WithTimeout(ctx, share)
+	return kitchenCtx, paymentCtx, deliveryCtx, func() { c1(); c2(); c3() }
+}
+
+func dispatchDownstream(ctx context.Context, order Order) error {
+	kitchenCtx, paymentCtx, deliveryCtx, cancel := splitDownstreamDeadlines(ctx)
+	defer cancel()
+
+	if err := callKitchenAvailability(kitchenCtx, order); err != nil {
 		return fmt.Errorf("runtime: kitchen availability: %w", err)
 	}
-	if err := callPaymentAuthorization(ctx, order); err != nil {
+	if err := callPaymentAuthorization(paymentCtx, order); err != nil {
 		return fmt.Errorf("runtime: payment authorization: %w", err)
 	}
-	if err := callDeliveryQuote(ctx, order); err != nil {
+	if err := callDeliveryQuote(deliveryCtx, order); err != nil {
 		return fmt.Errorf("runtime: delivery quote: %w", err)
 	}
 	return nil
 }
