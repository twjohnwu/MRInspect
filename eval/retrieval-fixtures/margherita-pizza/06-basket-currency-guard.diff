 }
+
+// TestBasket_AddPromoItem_RejectsMixedCurrency guards against the promo
+// bypass: a promo credit in a different currency code from the existing
+// basket items must be rejected the same way addItem rejects it.
+func TestBasket_AddPromoItem_RejectsMixedCurrency(t *testing.T) {
+	b := &Basket{}
+	if err := b.addItem(Item{CurrencyCode: "TWD", MinorUnits: 32000}); err != nil {
+		t.Fatalf("addItem: %v", err)
+	}
+
+	err := b.addPromoItem(Item{CurrencyCode: "USD", MinorUnits: 500})
+	if err == nil {
+		t.Fatal("want mixed-currency error from addPromoItem, got nil")
+	}
+	if len(b.Items) != 1 {
+		t.Fatalf("basket must not retain the rejected promo item, got %d items", len(b.Items))
+	}
+}
