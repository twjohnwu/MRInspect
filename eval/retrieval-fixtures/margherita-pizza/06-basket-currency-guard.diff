Author: kitchen-bot <kitchen-bot@margherita-pizza.internal>
Date:   Wed Sep 09 11:32:47 2026 +0800

    fix(orderapi): reject mixed-currency baskets before authorization (promo bypass)

    validateBasket() only checked currency consistency for items added
    through addItem(), but a promotional item attached via addPromoItem()
    skipped the shared validation path entirely. A basket could reach
    payment authorization with a TWD entree and a USD promo credit,
    producing float rounding drift once totals were summed. Both entry
    points now funnel through validateCurrencyConsistency before checkout.

diff --git a/internal/orderapi/basket.go b/internal/orderapi/basket.go
index 5a2e819..d074bf2 100644
--- a/internal/orderapi/basket.go
+++ b/internal/orderapi/basket.go
@@ -30,7 +30,7 @@ func (b *Basket) addItem(item Item) error {
 	if err := validateCurrencyConsistency(b.Items, item); err != nil {
 		return err
 	}
 	b.Items = append(b.Items, item)
 	return nil
 }

-func (b *Basket) addPromoItem(item Item) {
-	// promo credits are trusted and skip item validation
-	b.Items = append(b.Items, item)
-}
+func (b *Basket) addPromoItem(item Item) error {
+	if err := validateCurrencyConsistency(b.Items, item); err != nil {
+		return fmt.Errorf("orderapi: promo item currency %q does not match basket: %w", item.CurrencyCode, err)
+	}
+	b.Items = append(b.Items, item)
+	return nil
+}

 func validateCurrencyConsistency(existing []Item, next Item) error {
 	for _, item := range existing {
 		if item.CurrencyCode != next.CurrencyCode {
 			return fmt.Errorf("orderapi: mixed currency in basket: %s vs %s", item.CurrencyCode, next.CurrencyCode)
 		}
 	}
 	return nil
 }
