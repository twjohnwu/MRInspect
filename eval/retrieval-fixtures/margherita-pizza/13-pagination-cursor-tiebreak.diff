+++ b/internal/orderapi/pagination_test.go
@@ -10,3 +10,22 @@ func TestEncodeOrderCursor_RoundTrips(t *testing.T) {
 		t.Fatal("want cursor to decode back to the same placedAt")
 	}
 }
+
+// TestNextPageQuery_BreaksTiesByOrderID guards against the bug: orders
+// sharing the same placedAt millisecond must still resolve to a stable
+// deterministic secondary order by order identifier.
+func TestNextPageQuery_BreaksTiesByOrderID(t *testing.T) {
+	cursor := orderCursor{PlacedAt: sameInstant, OrderID: "order-42"}
+	query := nextPageQuery(cursor)
+	if !strings.Contains(query, "order_id") {
+		t.Fatalf("nextPageQuery = %q, want an order_id tie-breaker", query)
+	}
+}
