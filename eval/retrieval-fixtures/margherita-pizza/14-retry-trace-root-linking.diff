+// TestRetryKitchenDispatch_RetryLinksToOriginalRoot guards against the
+// bug: a retried dispatch must attach a distinct attempt span under the
+// order's existing trace root, not start an unrelated new root.
+func TestRetryKitchenDispatch_RetryLinksToOriginalRoot(t *testing.T) {
+	ctx, root := startTraceRoot(context.Background(), "order-77")
+	if err := retryKitchenDispatch(ctx, Order{ID: "order-77"}, 2); err != nil {
+		t.Fatalf("retryKitchenDispatch: %v", err)
+	}
+	if got := root.AttemptSpanCount(); got != 1 {
+		t.Fatalf("root.AttemptSpanCount() = %d, want 1 linked attempt span", got)
+	}
