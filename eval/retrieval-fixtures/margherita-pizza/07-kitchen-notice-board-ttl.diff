+
+// TestBoard_ReadSweepsExpiredNotice verifies the unbounded-growth fix: a
+// notice older than its TTL is swept from the board on Read instead of
+// being retained forever.
+func TestBoard_ReadSweepsExpiredNotice(t *testing.T) {
+	now := time.Date(2026, 9, 10, 12, 0, 0, 0, time.UTC)
+	b := &Board{clock: func() time.Time { return now }}
+	stale := Notice{Body: "closed for renovation", PostedAt: now.Add(-2 * time.Hour), TTL: time.Hour}
+	if err := b.Post(stale); err != nil {
+		t.Fatalf("Post: %v", err)
+	}
+
+	if got := b.Read(); len(got) != 0 {
+		t.Fatalf("want stale notice swept, got %d notices", len(got))
+	}
+}
+
+// TestBoard_Post_RejectsNonPositiveTTL guards against a notice posted
+// without a TTL, which previously stayed on the board forever.
+func TestBoard_Post_RejectsNonPositiveTTL(t *testing.T) {
+	b := &Board{clock: time.Now}
+	err := b.Post(Notice{Body: "no ttl", TTL: 0})
+	if err == nil {
+		t.Fatal("want error for non-positive TTL, got nil")
+	}
+}
