Author: kitchen-bot <kitchen-bot@margherita-pizza.internal>
Date:   Thu Sep 10 08:47:19 2026 +0800

    fix(noticeboard): expire kitchen notices after configured TTL instead of growing unbounded

    The kitchen notice board accumulated every posted notice for the
    lifetime of the process; closed-kitchen and past-deal notices stayed
    visible and the in-memory slice grew without bound. Reads now sweep
    entries older than the configured TTL before returning the board, and
    Post rejects a notice whose TTL is zero or negative instead of storing
    it forever.

diff --git a/internal/noticeboard/board.go b/internal/noticeboard/board.go
index 8c15e2b..a936017 100644
--- a/internal/noticeboard/board.go
+++ b/internal/noticeboard/board.go
@@ -18,15 +18,32 @@ type Notice struct {
 	Body      string
 	PostedAt  time.Time
+	TTL       time.Duration
 }

 type Board struct {
 	clock   func() time.Time
 	notices []Notice
 }

-func (b *Board) Post(n Notice) {
+func (b *Board) Post(n Notice) error {
+	if n.TTL <= 0 {
+		return fmt.Errorf("noticeboard: notice %q has non-positive TTL", n.Body)
+	}
 	b.notices = append(b.notices, n)
+	return nil
 }

 func (b *Board) Read() []Notice {
+	now := b.clock()
+	fresh := b.notices[:0]
+	for _, n := range b.notices {
+		if now.Sub(n.PostedAt) < n.TTL {
+			fresh = append(fresh, n)
+		}
+	}
+	b.notices = fresh
 	return b.notices
 }
