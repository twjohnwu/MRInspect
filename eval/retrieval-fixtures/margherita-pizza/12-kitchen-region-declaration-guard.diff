 }
+
+// TestValidateKitchenConfig_RejectsUndeclaredRoutingRegion guards against
+// the bug: a routing rule for a region the kitchen never declared must
+// fail startup validation instead of falling through to default values.
+func TestValidateKitchenConfig_RejectsUndeclaredRoutingRegion(t *testing.T) {
+	cfg := KitchenConfig{
+		KitchenID: "kitchen-east",
+		Regions:   []Region{{Name: "riverside"}},
+		RoutingRules: []RoutingRule{
+			{RegionName: "hillside"},
+		},
+	}
+	if err := validateKitchenConfig(cfg); err == nil {
+		t.Fatal("want undeclared-region error, got nil")
+	}
+}
