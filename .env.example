# ── Required secrets ──────────────────────────────────────────────────────────
AI_PROVIDER_KEY=             # Gemini / Anthropic / OpenAI key (matches AI_PROVIDER)
ANTHROPIC_API_KEY=           # Required by superpowers layer (Claude Code CLI)
GITLAB_TOKEN=                # GitLab token with api + write_repository scopes

# ── AI provider ───────────────────────────────────────────────────────────────
AI_PROVIDER=openai           # anthropic | gemini | openai
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MAX_TOKENS=4000
# Free tier has no quota for 3.1 Pro; free-tier keys should set GEMINI_MODEL=gemini-2.5-flash.
# GEMINI_MODEL=gemini-3.1-pro-preview
# GEMINI_MAX_TOKENS=8000
# OPENAI_MODEL=gpt-5.6
# OPENAI_MAX_TOKENS=4000
# AI_PER_CALL_TIMEOUT_MS=120000  # per-attempt AI call timeout, ms
# MRI_AI_LOG_DIR=  # local AI transcript directory; empty disables logging

# ── Service identity ──────────────────────────────────────────────────────────
MRI_SERVICE_NAME=unknown  # must match a key in projects/registry.yaml
MRI_SERVICE_TYPE=backend  # backend | frontend | ai | iac

# ── RAG store ────────────────────────────────────────────────────────────────
# MRI_RAG_SOURCE=package,artifact,baked  # store source chain
# MRI_RAG_STORE=  # explicit sqlite path for the path source
# MRI_RAG_PACKAGE_VERSION=  # pin the package source version

# ── GitLab CI vars (auto-set in CI; fill manually for local runs) ─────────────
CI_PIPELINE_SOURCE=merge_request_event
CI_PROJECT_ID=
CI_MERGE_REQUEST_IID=
CI_COMMIT_REF_NAME=          # source branch
CI_MERGE_REQUEST_TARGET_BRANCH_NAME=main

# ── Cross-repo trigger mode (uncomment when CI_PIPELINE_SOURCE=trigger) ───────
# MRI_PROJECT_ID=
# MRI_MR_IID=
# MRI_SOURCE_BRANCH=
# MRI_TARGET_BRANCH=

# ── Review behavior ──────────────────────────────────────────────────────────
# MRI_REVIEW_MODE=single  # single | multi review mode
# MRI_LANE_CONCURRENCY=4  # maximum parallel review lanes
# MRI_REVIEW_DUMP_ENABLED=false  # exact "true" enables failure-only prompt/response dumps
# MRI_DIFF_PROMPT_SHARE=0.85  # diff share of prompt budget
# MRI_PROMPT_BUDGET_FACTOR=0.8  # prompt budget headroom factor
# MRI_MODEL_LIMITS=  # comma-separated model:tokens overrides
# MRI_RAG_ON_NORMATIVE_EVICTION=warn  # warn | fail when normative content is evicted

# ── Offline eval ──────────────────────────────────────────────────────────────
# MRI_DAILY_TOKEN_BUDGET=2500000  # single-run comparison; unset disables
# MRI_EVAL_ALLOW_CI=false  # exact "true" allows mrinspect eval inside CI

# ── Optional tuning ───────────────────────────────────────────────────────────
# IS_SELF_REFLECTION=false
# PROJECTS_DIR=./projects
# GITLAB_API_BASE=https://gitlab.com/api/v4
# LOG_LEVEL=info
# MAX_FILES_CHANGED=50
# API_RETRY_ATTEMPTS=3
# API_RETRY_DELAY_MS=1000
# API_MAX_RETRY_DELAY_MS=10000
# API_TIMEOUT_MS=30000
# AI_RETRY_ATTEMPTS=3
# AI_REVIEW_METRICS_FILE=./mrinspect-metrics.json
